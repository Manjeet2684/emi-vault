# Local Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=emi_vault

# Hosted Postgres (Render / Neon / Supabase). If set, the fields above are ignored.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Render sets this automatically. Local default is 3000.
# PORT=3000

# Comma-separated extra browser origins allowed by CORS
# localhost:5173 and localhost:5174 are always allowed for local Vite
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Set true/false to force SSL. Hosted DATABASE_URL enables SSL by default.
# DB_SSL=true
